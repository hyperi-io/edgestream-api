[Unit]
Description=EdgeStream Ansible Queue Runner
# Ensure the API is up before the runner tries to log in/poll
After=network-online.target edgestream-api.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

# Use systemd to manage directories and permissions automatically
RuntimeDirectory=edgestream/ansible_queue
LogsDirectory=edgestream-api
LogsDirectoryMode=0750

# Load the secrets generated by database_init.bin
EnvironmentFile=/etc/edgestream/edgestream-api.secrets
# Map the secret from the file to the environment variable the Python script expects
Environment=EDGESTREAM_QUEUE_TOKEN=${EDGESTREAM_QUEUE_TOKEN}
Environment=EDGESTREAM_API_URL=http://127.0.0.1:3001/api/v1
Environment=HOME=/var/lib/edgestream/ansible_cache
Environment=ANSIBLE_LOCAL_TEMP=/var/lib/edgestream/ansible_cache/tmp
Environment=ANSIBLE_REMOTE_TMP=/var/lib/edgestream/ansible_cache/tmp

# The actual command
ExecStart=/opt/edgestream-api/bin/python /opt/edgestream-api/bin/ansible-queue-runner.py

NoNewPrivileges=no
ProtectSystem=no
ProtectHome=no
PrivateTmp=no
PrivateNetwork=no

Restart=on-failure
RestartSec=5s

# Logging
StandardOutput=journal
SyslogIdentifier=edgestream-ansible-queue

[Install]
WantedBy=multi-user.target
